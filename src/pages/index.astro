---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import PrivacyPromise from '../components/sections/PrivacyPromise.astro';
import Ledger from '../components/sections/Ledger.astro';
import CurrenciesBudgets from '../components/sections/CurrenciesBudgets.astro';
import Features from '../components/sections/Features.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { SITE } from '../consts';
---

<Layout title={`${SITE.name} · ${SITE.tagline}`} current="home">
  <Hero />
  <PrivacyPromise />
  <Ledger />
  <CurrenciesBudgets />
  <Features />
  <FinalCta />
</Layout>
