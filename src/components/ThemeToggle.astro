---
/**
 * Light/dark switch. The app stores an explicit preference rather than
 * following the system setting, and the site does the same: the choice is
 * written to localStorage and survives navigation.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="grid h-11 w-11 place-items-center rounded-full border border-[var(--border)] text-text2 transition-colors hover:bg-[color-mix(in_oklab,var(--text)_8%,transparent)] hover:text-text"
  aria-label="Switch to light theme"
>
  <span data-icon="moon">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5"></path>
    </svg>
  </span>
  <span data-icon="sun" hidden>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4.2"></circle>
      <path
        d="M12 2v2.4M12 19.6V22M22 12h-2.4M4.4 12H2M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7M19.1 19.1l-1.7-1.7M6.6 6.6 4.9 4.9"
      ></path>
    </svg>
  </span>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const moon = document.querySelector<HTMLElement>('[data-icon="moon"]');
  const sun = document.querySelector<HTMLElement>('[data-icon="sun"]');

  /** Keep the icon and the button's label describing the *next* state. */
  function sync(theme: string) {
    const light = theme === 'light';
    if (moon) moon.hidden = light;
    if (sun) sun.hidden = !light;
    btn?.setAttribute(
      'aria-label',
      light ? 'Switch to dark theme' : 'Switch to light theme',
    );
  }

  sync(document.documentElement.dataset.theme ?? 'dark');

  btn?.addEventListener('click', () => {
    const next =
      document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('pockit-theme', next);
    } catch {
      /* Private browsing: the choice just will not persist. */
    }
    sync(next);
  });
</script>
