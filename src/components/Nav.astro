---
import { SITE } from '../consts';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import DownloadButton from './DownloadButton.astro';

interface Props {
  /** Marks the current page in the nav for both sighted and AT users. */
  current?: 'home' | 'privacy';
}

const { current } = Astro.props;

const links = [
  { href: '/#features', label: 'Features', key: 'features' },
  { href: '/privacy', label: 'Privacy', key: 'privacy' },
];
---

<header
  class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bar)] backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-14 max-w-[1200px] items-center justify-between px-6 md:px-10"
    aria-label="Main"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 text-text hover:text-text"
      aria-label={`${SITE.name} home`}
    >
      <img src="/brand/logo-mark.png" alt="" width="22" height="27" class="h-[22px] w-auto" />
      <span class="text-[15px] font-semibold tracking-[-0.01em]">{SITE.name}</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-[13px] transition-colors hover:text-text',
              current === link.key
                ? 'font-semibold text-text'
                : 'text-text2',
            ]}
            aria-current={current === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
      <DownloadButton size="sm" />
    </div>

    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="grid h-11 w-11 place-items-center rounded-full text-text"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <Icon name="menu" size={20} strokeWidth={2} />
      </button>
    </div>
  </nav>

  <div
    id="nav-panel"
    class="hidden border-t border-[var(--border)] bg-[var(--bar)] px-6 pb-5 pt-2 backdrop-blur-xl md:hidden"
  >
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'flex min-h-[48px] items-center text-[16px] transition-colors hover:text-text',
                current === link.key ? 'font-semibold text-text' : 'text-text2',
              ]}
              aria-current={current === link.key ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-3">
      <DownloadButton full />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');

  function setOpen(open: boolean) {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    // `hidden` alone loses to the `display` utility on the panel, so the class
    // is what actually shows it.
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Tapping a link navigates within the page; close so the panel is not left
  // covering the section that was just jumped to.
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false)),
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
