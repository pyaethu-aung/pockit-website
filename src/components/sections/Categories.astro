---
import Icon from '../Icon.astro';

const expense = [
  { label: 'Food & Dining', hue: 'var(--cat-food)' },
  { label: 'Transport', hue: 'var(--cat-transport)' },
  { label: 'Shopping', hue: 'var(--cat-shopping)' },
  { label: 'Bills & Utilities', hue: 'var(--cat-bills)' },
  { label: 'Groceries', hue: 'var(--cat-groceries)' },
  { label: 'Health', hue: 'var(--cat-health)' },
  { label: 'Travel', hue: 'var(--cat-travel)' },
] as const;

const income = [
  { label: 'Salary', hue: 'var(--cat-health)' },
  { label: 'Business', hue: 'var(--cat-transport)' },
  { label: 'Investment', hue: 'var(--cat-groceries)' },
  { label: 'Gift', hue: 'var(--cat-shopping)' },
  { label: 'Refund', hue: 'var(--cat-bills)' },
] as const;
---

<section class="section">
  <div class="shell flex flex-col items-center text-center">
    <p class="t-eyebrow">Categories</p>
    <h2 class="t-h2 mt-3.5 max-w-[820px]">
      Income and expenses, filed separately.
    </h2>
    <p class="t-body mt-5 max-w-[640px]">
      Track what comes in and what goes out with ease. Keep your finances
      organized and easy to understand.
    </p>

    <div
      class="mt-14 grid w-full max-w-[1000px] grid-cols-1 gap-6 text-left md:grid-cols-2"
    >
      <div class="card p-7">
        <div class="mb-5 flex items-center gap-2 text-neg">
          <Icon name="arrow-down" size={15} strokeWidth={3} />
          <span class="text-[13px] font-bold uppercase tracking-[0.08em]">
            Expense
          </span>
        </div>
        <ul class="flex flex-wrap gap-2.5">
          {
            expense.map((cat) => (
              <li
                class="flex h-[42px] items-center gap-2.5 rounded-full border border-[var(--border)] bg-bg pl-2 pr-4"
              >
                <span
                  class="h-[26px] w-[26px] rounded-full"
                  style={`background: ${cat.hue}`}
                  aria-hidden="true"
                />
                <span class="text-[14px] font-medium">{cat.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-7">
        <div class="mb-5 flex items-center gap-2 text-pos">
          <Icon name="arrow-up" size={15} strokeWidth={3} />
          <span class="text-[13px] font-bold uppercase tracking-[0.08em]">
            Income
          </span>
        </div>
        <ul class="flex flex-wrap gap-2.5">
          {
            income.map((cat) => (
              <li
                class="flex h-[42px] items-center gap-2.5 rounded-full border border-[var(--border)] bg-bg pl-2 pr-4"
              >
                <span
                  class="h-[26px] w-[26px] rounded-full"
                  style={`background: ${cat.hue}`}
                  aria-hidden="true"
                />
                <span class="text-[14px] font-medium">{cat.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
