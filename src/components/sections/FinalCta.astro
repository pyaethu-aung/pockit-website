---
import DownloadButton from '../DownloadButton.astro';
import { SITE } from '../../consts';

const notifyHref = `mailto:${SITE.email}?subject=Notify%20me%20when%20Pockit%20launches`;
---

<section
  class="section border-t border-[var(--border)] bg-surface text-center"
>
  <div class="shell flex flex-col items-center">
    <h2 class="t-h2-lg max-w-[780px]">Coming to the App Store.</h2>
    <p class="t-lead mt-5 max-w-[560px]">
      Free, no account, and everything stays on your phone.
    </p>
    <div class="mt-9 flex w-full max-w-[340px] flex-col items-center gap-3">
      <DownloadButton full />
      <a href={notifyHref} class="text-[14px] font-semibold text-accent">
        Email me when it&rsquo;s on the App Store
      </a>
    </div>
    <p class="mt-4 text-[13px] text-text3">
      iPhone first &mdash; an Android version is coming to Google Play.
    </p>

    <p class="mt-12 text-[13px] text-text3">
      Built by Pyae Thu Aung.
      <a href={`mailto:${SITE.email}`} class="font-medium">Questions welcome.</a>
    </p>
  </div>
</section>
