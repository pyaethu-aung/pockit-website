---
import DownloadButton from '../DownloadButton.astro';
---

<section
  class="section border-t border-[var(--border)] bg-surface text-center"
>
  <div class="shell flex flex-col items-center">
    <h2 class="t-h2-lg max-w-[780px]">Start tracking now.</h2>
    <p class="t-lead mt-5 max-w-[560px]">
      Free, no account, and everything stays on your phone.
    </p>
    <div class="mt-9 flex w-full max-w-[340px] flex-col items-center gap-3">
      <DownloadButton full />
    </div>
    <span class="mt-4 text-[13px] text-text3">
      Android version coming to Google Play.
    </span>
  </div>
</section>
