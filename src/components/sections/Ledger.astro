---
import PhoneFrame from '../PhoneFrame.astro';
import Screenshot from '../Screenshot.astro';
import Icon from '../Icon.astro';
import type { IconName } from '../../icons';

const points: { icon: IconName; text: string }[] = [
  {
    icon: 'transfer',
    text: 'Income and expenses are filed on their own sides. Moving money between your own accounts counts as neither.',
  },
  {
    icon: 'search',
    text: 'Filter a tab by note, category, account or tag; the chart above it holds still.',
  },
  {
    icon: 'pie',
    text: 'A category breakdown adds up as you go, so the month never surprises you at the end.',
  },
];
---

<section class="section" id="ledger">
  <div
    class="shell flex flex-col items-center gap-14 lg:flex-row lg:justify-center lg:gap-22"
  >
    <div class="lg:w-[480px]">
      <p class="t-eyebrow">The ledger</p>
      <h2 class="t-h2 mt-3.5">Add. Done.</h2>
      <p class="t-body mt-5">
        Type an amount, pick a category and an account, save. The whole
        transaction takes one screen and lands in the database on your phone.
      </p>

      <ul class="mt-7 flex flex-col gap-3.5">
        {
          points.map((point) => (
            <li class="flex items-start gap-3 text-[15px] leading-[1.55] text-text2">
              <span class="mt-0.5 shrink-0 text-accent">
                <Icon name={point.icon} size={18} strokeWidth={2} />
              </span>
              {point.text}
            </li>
          ))
        }
      </ul>

      <p
        class="card card--inset mt-7 flex items-center gap-2.5 rounded-[16px] px-4.5 py-3.5 text-[15px] text-text2"
      >
        <span class="shrink-0 text-accent"><Icon name="undo" size={18} strokeWidth={2} /></span>
        Every save is confirmed with a five-second Undo.
      </p>
    </div>

    <PhoneFrame
      height={735}
      label="The add-transaction sheet: an expense of 129 dollars on the keypad, Groceries selected as the category, the Cash account showing 522.50 left, and a Save key."
    >
      <Screenshot dark="/screenshots/entry-dark.png" light="/screenshots/entry-light.png" />
    </PhoneFrame>
  </div>
</section>
