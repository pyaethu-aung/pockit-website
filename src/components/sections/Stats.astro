---
import PhoneFrame from '../PhoneFrame.astro';
import Screenshot from '../Screenshot.astro';
---

<section class="section">
  <div
    class="shell flex flex-col items-center gap-14 lg:flex-row-reverse lg:justify-center lg:gap-22"
  >
    <div class="lg:w-[480px]">
      <p class="t-eyebrow">Stats</p>
      <h2 class="t-h2 mt-3.5">See the bigger picture.</h2>
      <p class="t-body mt-5">
        Understand exactly where your money goes with clear spending insights
        and detailed breakdowns. Spot patterns, compare categories, and get
        a better sense of your financial habits over time.
      </p>
    </div>

    <PhoneFrame
      height={735}
      label="The Stats tab: an Expense and Income switch, and a donut chart totalling 846.82 dollars of expenses, ranked beneath as Groceries 33 percent, Food and Dining 26 percent, Bills and Utilities 18 percent, Shopping 10 percent, Transport 8 percent, Health 3 percent, Entertainment 2 percent."
    >
      <Screenshot dark="/screenshots/stats-dark.png" light="/screenshots/stats-light.png" />
    </PhoneFrame>
  </div>
</section>
