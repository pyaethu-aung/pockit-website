---
import { SITE } from '../consts';
---

<footer class="border-t border-[var(--border)] bg-bg px-6 pb-12 pt-16 md:px-10">
  <div
    class="shell shell--wide flex flex-col gap-12 md:flex-row md:justify-between"
  >
    <div class="max-w-[300px]">
      <div class="flex items-center gap-2.5">
        <img src="/brand/logo-mark.png" alt="" width="20" height="24" class="h-5 w-auto" />
        <span class="text-[14px] font-semibold">{SITE.name}</span>
      </div>
      <p class="mt-3.5 text-[13.5px] leading-[1.6] text-text3">
        A local-first expense tracker for iPhone. No account, no sync,
        no server: everything stays in a database on your device.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-16 gap-y-10" aria-label="Footer">
      <div class="flex flex-col gap-3">
        <span class="label-caps">Product</span>
        <a href="/#features" class="text-[14px] text-text2">Features</a>
        <a href="/#privacy" class="text-[14px] text-text2">Private by design</a>
      </div>
      <div class="flex flex-col gap-3">
        <span class="label-caps">Legal</span>
        <a href="/privacy" class="text-[14px] text-text2">Privacy Policy</a>
        <a href={`mailto:${SITE.email}`} class="text-[14px] text-text2">Support</a>
      </div>
      <div class="flex flex-col gap-3">
        <span class="label-caps">Contact</span>
        <a href={`mailto:${SITE.email}`} class="text-[14px] break-all text-text2">
          {SITE.email}
        </a>
      </div>
    </nav>
  </div>

  <div
    class="shell shell--wide mt-11 border-t border-[var(--border)] pt-6 text-[12.5px] text-text3"
  >
    &copy; {new Date().getFullYear()} {SITE.author}. All rights reserved.
  </div>
</footer>
